@using Personajes;
@using Studio.mvc.ViewModel
@model VMPersonaje
@{
    ViewData["Title"] = "Peliculas Page";

    int contador=0;
}

<div>
    @if(Model.idPersonaje==0)
    {
        <h2>Agregar Personaje</h2>
    }
    else{
        <h2>Modificar Personaje n° @Model.idPersonaje </h2>
    }
</div>

<form asp-controller="Personajes" asp-action="Upsert" method="post">
    <div asp-validation-summary="All"></div>
    <div><input type="hidden" asp-for="@Model.idPersonaje" /></div>
    <div><input type="hidden" asp-for="@Model.ListadoPeliculas" /></div>
    <div><input type="hidden" asp-for="@Model.ListadoActores" /></div>
    <div>
        <div>
            <label>Nombre: </label>
            <input asp-for="Nombre" class="form-control">
        </div>
        <div class="ConjuntoSelectors">
            <div class="Conjunto">
                <label for="">Pelicula: </label>
                <select asp-items="Model.Peliculas" asp-for="idPelicula" id="ImputPeli">
                        <option selected="selected" value="" disabled>Seleccione una Pelicula</option>
                </select>

                @foreach(var peli in Model.ListadoPeliculas)
                {
                    <div class="ImgPosterP" data-valor="@peli.IdPelicula">
                        <img src="@peli.IMG" alt=""  id="@("Pimg"+contador)" >
                    </div>
                    contador++;
                }
                @{contador=0;}

                <script>
                    let posters= document.getElementsByClassName("ImgPosterP");
                    let imputP= document.getElementById("ImputPeli")

                    imputP.addEventListener('change', mostrarPelicula())

                    function mostrarPelicula()
                    {
                        valor= this.value;
                        console.log(valor)

                        for(p=0; p< posters.length; p++)
                        {
                            if(parseInt(posters[p].dataset.valor) == (valor))
                            {
                                posters[p].style.display = 'flex';
                                console.log(posters[p].dataset.valor)
                            }
                            else
                            {
                                posters[p].style.display = 'none';
                            }
                            
                        }
                    }
                </script>
            </div>
            <div class="Conjunto">
                <label for=""> Actor:  </label>
                <select asp-items="Model.Actores" asp-for="idActor" id="ImputActor">
                        <option selected="selected" value="" disabled>Seleccione un Actor</option>
                </select>

                @foreach(var actor in Model.ListadoActores)
                {
                    <div class="ImgActorP" data-valor="@actor.IdActor">
                        <div>
                            <img src="@actor.IMG" alt=""  id="@("Pimg"+contador)" >
                            <p>@actor.Nombre @actor.Apellido</p>
                        </div>
                    </div>
                    contador++;
                }
                @{contador=0;}

                <script>
                    let actores= document.getElementsByClassName("ImgActorP");
                    let imputA= document.getElementById("ImputActor")

                    imputA.addEventListener('change', mostrarActor())
                    
                    function mostrarActor()
                    {
                        valor= this.value;
                        console.log(valor)

                        for(p=0; p< actores.length; p++)
                        {
                            if(parseInt(actores[p].dataset.valor) == (valor))
                            {
                                actores[p].style.display = 'flex';
                            }
                            else
                            {
                                actores[p].style.display = 'none';
                            }
                        }
                    }
                </script>

            </div>
        </div>

        <div id="ModimgP">
            <label for="">Perfil: </label>
            <input id="URLIMG" asp-for="IMG" class="form-control"/>
            <img id="IMGRsultado" src="@Model.IMG" alt="Imagen no detectada">
                
            <script>
                let enlace= document.getElementById("URLIMG")
                let img= document.getElementById("IMGRsultado")
            
                enlace.addEventListener("keyup", function mostrar()
                {
                    img.src=enlace.value
                })

            </script>
        </div>
    </div>

    <div class="col-auto">
        @if (Model.idPersonaje == 0)
        {
            <button type="submit" class="btn btn-primary">Agregar Personaje</button>
        }
        else
        {
            <button type="submit" class="btn btn-warning">Modificar Personaje n°@Model.idPersonaje</button>
        }
    </div>
</form>
