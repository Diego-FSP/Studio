@using Personajes
@model IEnumerable<Personaje>

@{
    ViewData["Title"] = "Personaje Page";
}

<html>
<body>
    <h3>Listado</h3>
    <label >Buscador:</label>
    <input id="Buscador" type="text">
    <div class="Muestra">
        @foreach(var repo in Model)
        {
            <div class="itemPersonaje">
                <a asp-action="Detalle" asp-route-id="@repo.idPersonaje">
                    <img class="" src="@repo.IMG" alt="">
                    <label>@repo.Nombre</label>
                </a>
            </div>
        }
    </div>

    <script>
        let Buscador= document.getElementById("Buscador")
        
        Buscador.addEventListener("keyup", function filtro()
        {
            listado = document.getElementsByClassName("itemPersonaje")
            for(f=0;f<listado.length;f++)
            {
                texto=listado[f].textContent
                if(texto.includes(Buscador.value) || (texto.toLowerCase()).includes(Buscador.value))
                {
                    listado[f].style.display = 'flex';
                }
                else
                {
                    listado[f].style.display = 'none';
                }
            }
        })
    </script>
</body>
</html>