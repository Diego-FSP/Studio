@using Directores;
@model Director;
@{
    ViewData["Title"] = "Directores Page";
    var texto = Model.idDirector == 0 ? "Agregar Director" : "Modificar Director";

}

<div>
    @if(Model.idDirector==0)
    {
        <h2>Agregar Director</h2>
    }
    else{
        <h2>Modificar Director n° @Model.idDirector </h2>
    }
</div>

<form asp-controller="Directores" asp-action="Upsert" method="post">
    <div asp-validation-summary="All"></div>
    <div><input type="hidden" asp-for="@Model.idDirector" /></div>
    
    <div >
        <div >
            <label asp-for="Nombre" >Nombre</label>
        </div>
        <div >
            <input asp-for="Nombre" class="form-control"/>
        </div>
    </div>

    <div >
        <div class="">
            <label asp-for="Apellido" class="">Apellido</label>
        </div>
        <div class="">
            <input asp-for="Apellido"  class="form-control"/>
        </div>
    </div>

    <div></div>
        <div>
            <label asp-for="descripcion">Descripcion</label>
        </div>
        <div class="">
            <textarea asp-for="descripcion" id="Descripcion"></textarea>
        </div>
        <div class="">
            <label asp-for="FechaNacimiento" class="">Nacimiento</label>
            <input type="date" asp-for="FechaNacimiento" class="">
        </div>

        <div>
            <label for="">Nacionalidad</label>
            <select asp-for="nacionalidad" class="">
                <option selected="selected" value="" disabled>Seleccione un pais</option>
                <option selected="selected" value="Japonesa" >Japonesa</option>
                <option selected="selected" value="Estadounidense" >Estadounidense</option>
            </select>
        </div>
        
        <div>
            <label asp-for="IMG" class="">Imagen</label>
        </div>
        <div id="ModimgP">
            <input id="URLIMG" asp-for="IMG" class=""/>
            <img class="ImgDirectores" id="IMGRsultado" src="@Model.IMG" alt="">
            
            <script>
                let enlace= document.getElementById("URLIMG")
                let img= document.getElementById("IMGRsultado")
            
            enlace.addEventListener("keyup", function mostrar()
            {
                img.src=enlace.value
            })
            </script>
        </div>
    </div>

    <div>
    </div>

    <div class="">
        @if (Model.idDirector == 0)
        {
            <button type="submit" class="btn btn-primary">@texto</button>
        }
        else
        {
            <button type="submit" class="btn btn-warning">@texto</button>
        }
    </div>

<style>
</style>
</form>