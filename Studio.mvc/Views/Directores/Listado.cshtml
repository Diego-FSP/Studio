@{
    ViewData["Title"] = "Directores Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="wwwroot/css/Listas.css">
    <title>Document</title>
</head>
<body>
    <h1 class="display-4">Directores</h1>
    <h3>Listado</h3>

    <div class="Muestra">
        @foreach(var dir in Model)
        {
            <div class="CasillaG">
                <a asp-action="Detalle" asp-route-Id="@dir.idDirector">
                    <div class="Mimg"><img src="@dir.IMG" alt=""></div>
                    <label>@dir.Nombre @dir.Apellido</label>
                    <div class="Brillo"> <div class="BrilloA"></div> </div>
                </a>
                    <a asp-action="Modificar" asp-route-Id="@dir.idDirector">Modificar</a>
                
            </div>
        }
    </div>
</div>
</body>

<style>
    body{
        background-color: rgb(38, 42, 245);
    }
</style>
</html>


