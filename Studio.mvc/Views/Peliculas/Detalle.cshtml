@{
    ViewData["Title"] = "Peliculas Page";
}

<body>
    <h1>@Model.Nombre</h1>
    <div id="info">
        <img id="Poster" src="@Model.IMG" alt="">
        <div id="datos">
            <p><strong>Genero: </strong>@Model.Genero</p>
            <p><strong>Presupuesto: </strong>@Model.Presupuesto</p>
            <p><strong>Duracion: </strong>@Model.Duracion</p>
            <p><strong>Fecha de Estreno: </strong>@Model.FechaEstreno</p>
            <div id="Director">
                <p>Director: @Model.director.Nombre @Model.director.Apellido </p>
                <img id="IMGDirector" src="@Model.director.IMG" alt="">
            </div>
        </div>
    </div>

    <table>
    <thead>
            <tr>
                <th>Perfil</th>
                <th>Personajes</th>
                <th>Actores</th>
            </tr>
        </thead>
    <tbody>
            @foreach(var repo in Model.Personajes)
            {
                <tr>
                    <th><img class="ImgPerfil" src="" alt=""></th>
                    <th><label for="">@repo.Nombre</label></th>
                    <th><label for=""><img src="@repo.Actor.IMG" alt="">  @repo.Actor.Nombre @repo.Actor.Apellido</label></th>
                </tr>
            }
        </tbody>
    </table>
</body>