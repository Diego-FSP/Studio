@{
    ViewData["Title"] = Model.Nombre;
}

<body>
    <h1>@Model.Nombre</h1>
    <div id="info">
        <img id="Poster" src="@Model.IMG" alt="">
        <div id="datos" style="display: flex;">
            <div>
                <p><strong>Director: </strong>@Model.director.Nombre @Model.director.Apellido </p>
                <p><strong>Calificacion: </strong>@Model.Calificacion</p>
                <p><strong>Genero: </strong>@Model.Genero</p>
                <p><strong>Presupuesto: </strong>$@Model.Presupuesto</p>
                <p><strong>Duracion: </strong>@Model.Duracion</p>
                <p><strong>Fecha de Estreno: </strong>@Model.FechaEstreno.ToString("dd/MM/yyyy")</p>
                <p><strong>Trailer: </strong></p>
                <iframe 
                    src="https://www.youtube.com/embed/@Model.Trailer" 
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                ></iframe>
            </div>
            <div id="Director" >
                <img class="ImgPerfil" style="margin-left: 50px;" src="@Model.director.IMG" alt="">
            </div>
        </div>
    </div>
    
    <table class="tabla">
        <thead>
            <tr>
                <th>Personajes</th>
                <th>Actores</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var repo in Model.Personajes)
            {
                <tr>
                    <th class="celda"> 
                        <div class="ImgTabla"> <img  src="@repo.IMG" alt=""></div> 
                        <label for="">@repo.Nombre</label>
                    </th>
                    <th class="celda">
                        <div class="ImgTabla"><img src="@repo.Actor.IMG" alt=""></div>
                        <label >@repo.Actor.Nombre @repo.Actor.Apellido</label>
                    </th>
                    
                    
                </tr>
            }
        </tbody>
    </table>
    
    <style>

    .Poster{
        box-shadow: 0px 0px 10px image-set("@Model.IMG");
    }
    .tabla{
        width: 75%;
        .celda{
            height: 300px;
            width: 50%;
        }
    }
    .ImgTabla{
        width: 100%;
        height: 80%;
        overflow:hidden;
        position:relative
    }
    .ImgTabla img{
        height: 100%;
        width: 100%;
        display: flex;
        object-fit:cover;
        display:flex;
    }
    thead{
        font-size: 130%;
    }
    </style>
</body>