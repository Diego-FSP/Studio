@using Peli;
@using Studio.mvc.ViewModel
@model VMPeliculaDP
@{
    ViewData["Title"] = "Peliculas Page";
    var texto = Model.pelicula.IdPelicula == 0 ? "Agregar pelicula" : "Modificar Pelicula";
}

<form asp-asp-controller="Peliculas" asp-action="Upsert" method="post">
<div>
    <div>
        <label>Nombre </label>
        <input asp-for="pelicula.Nombre" class="form-control">
    </div>
    <div>
        <label for="">Fecha de Estreno</label>
        <input type="date" asp-for="pelicula.FechaEstreno" id="">
    </div>
    <div>
        <label for="">Calificacion:</label>
        <input type="number" asp-for="Calificacion" id="calificacionid">
        <script>
            let cal= document.getElementById("calificacionid")
        
            cal.addEventListener("keyup", function limite()
            {
                if(cal.value<0)
                cal.value=0;
                if(cal.value>10)
                cal.value=10
            })
        </script>
    </div>
    <div>
        <label for="">Duracion: </label>
        <input asp-for="Duracion" type="number">
    </div>
    <div>
        <label for="">Genero</label>
        <select asp-for="pelicula.Genero" id="">
            <option value="Comedia">Comedia</option>
            <option value="Terror">Terror</option>
            <option value="Aventura">Aventura</option>
            <option value="Fantasia">Fantasia</option>
        </select>
    </div>
    <div>
        <label for="">Director</label>
        <select asp-for="pelicula.director" id="">
        @foreach(var director in @Model.directores)
        {
            <option value="@director"> <img class="ImgPerfil" src="@director.IMG"> @director.Nombre @director.Apellido</option>
        }
        </select>
    </div>
    <div>
        <label for="">Poster</label>
        <input id="URLIMG" asp-for="pelicula.IMG" class="form-control"/>
        <img class="ImgDirectores" id="IMGRsultado" src="@Model.pelicula.IMG" alt="">
            
        <script>
            let enlace= document.getElementById("URLIMG")
            let img= document.getElementById("IMGRsultado")
        
            enlace.addEventListener("keyup", function mostrar()
            {
                img.src=enlace.value
            })
        </script>
    </div>

</div>

<div class="col-auto">
        @if (Model.pelicula.IdPelicula == 0)
        {
            <button type="submit" class="btn btn-primary">@texto</button>
        }
        else
        {
            <button type="submit" class="btn btn-warning">@texto</button>
        }
    </div>
</form>