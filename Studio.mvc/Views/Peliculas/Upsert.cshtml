@using Peli;
@using Studio.mvc.ViewModel
@model VMPeliculaDP
@{
    ViewData["Title"] = "Peliculas Page";
}

<div>
    @if(Model.IdPelicula==0)
    {
        <h2>Agregar Pelicula</h2>
    }
    else{
        <h2>Modificar Pelicula n° @Model.IdPelicula </h2>
    }
</div>

<form asp-controller="Peliculas" asp-action="Upsert" method="post">
<div asp-validation-summary="All"></div>
<div><input type="hidden" asp-for="@Model.IdPelicula" /></div>
<div>
    <div>
        <label>Nombre: </label>
        <input asp-for="Nombre" class="form-control">
    </div>
    <div>
        <label for="">Fecha de Estreno</label>
        <input type="date" asp-for="FechaEstreno" id="">
    </div>
    <div>
        <label for="">Calificacion: </label>
        <input type="text" asp-for="Calificacion" id="calificacionid">
    </div>
    <div>
        <label for="">Duracion: </label>
        <input asp-for="Duracion" type="text">
    </div>
    <div>
        <label for="">Genero: </label>
        <select asp-for="Genero" id="">
            <option value="Comedia">Comedia</option>
            <option value="Terror">Terror</option>
            <option value="Aventura">Aventura</option>
            <option value="Fantasia">Fantasia</option>
        </select>
    </div>
    <div>
        <label for="">Director: </label>
        <select asp-items="Model.Directores" asp-for="idDirector" id="">
        </select>
    </div>
    <div>
    <label for="">Presupuesto: </label>
    <input asp-for="Presupuesto" type="number">
    </div>
    <div id="ModimgP">
        <label for="">Poster: </label>
        <input id="URLIMG" asp-for="IMG" class="form-control"/>
        <img id="IMGRsultado" src="@Model.IMG" alt="Imagen no detectada">
            
        <script>
            let enlace= document.getElementById("URLIMG")
            let img= document.getElementById("IMGRsultado")
        
            enlace.addEventListener("keyup", function mostrar()
            {
                img.src=enlace.value
            })
        </script>
    </div>

</div>

<div class="col-auto">
        @if (Model.IdPelicula == 0)
        {
            <button type="submit" class="btn btn-primary">Agregar Pelicula</button>
        }
        else
        {
            <button type="submit" class="btn btn-warning">Modificar Pelicula n°@Model.IdPelicula</button>
        }
    </div>
</form>