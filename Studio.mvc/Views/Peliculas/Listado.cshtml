@{
    ViewData["Title"] = "Peliculas";
}

<body>
    <h1 class="display-4">Pelicula</h1>
    <h3>Listado</h3>


    <label >Buscador:</label>
    <input id="Buscador" type="text">
    
    <div class="Muestra">
        @foreach(var repo in Model)
        {
            <div class="CasillaP">
                <a  asp-action="Detalle" asp-route-id="@repo.IdPelicula">
                    <div class="Pimg"><img src="@repo.IMG" alt=""></div> 
                </a>
                <div class="CasillaContenido">
                    <a  asp-action="Detalle" asp-route-id="@repo.IdPelicula"><label>@repo.Nombre</label></a>
                    <div>
                        <a asp-action="Modificar" asp-route-Id="@repo.IdPelicula">Modificar</a>
                    </div>
                    <div class="Brillo"> <div class="Bespacio"></div> <div class="BrilloA"></div></div>
                </div>
            </div>
        }
    </div>
    
    <script>
        let Buscador= document.getElementById("Buscador")
        
        Buscador.addEventListener("keyup", function filtro()
        {
            listado = document.getElementsByClassName("Casilla")
            for(f=0;f<listado.length;f++)
            {
                texto=listado[f].textContent
                if(texto.includes(Buscador.value) || (texto.toLowerCase()).includes(Buscador.value))
                {
                    listado[f].style.display = 'flex';
                }
                else
                {
                    listado[f].style.display = 'none';
                }
            }
        })
    </script>
    
</body>
<style>
    body{
        background-color: rgb(91, 27, 240);
    }
</style>