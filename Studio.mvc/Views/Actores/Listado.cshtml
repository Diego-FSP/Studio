@{
    ViewData["Title"] = "Directores Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="wwwroot/css/Listas.css">
    <title>Document</title>
</head>
<body>
    <h1 class="display-4">Actores</h1>
    <h3>Listado</h3>

    <table class="ListadoTabla">
        <thead>
            <th>Actores</th>
            <th>Acciones</th>
        </thead>
        <tbody>
            @foreach(var repo in Model)
            {
                <tr>
                    <th><a asp-action="Detalle" asp-route-Id="@repo.IdActor">@repo.Nombre @repo.Apellido</a></th>
                    <th><a>Modificar</a></th>
                </tr>
            }
        </tbody>
    </table>
</div>
</body>
</html>