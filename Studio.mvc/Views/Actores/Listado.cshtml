@using Actores
@model IEnumerable<ActorVoz>

@{
    ViewData["Title"] = "Actores Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Listas.css"> <!-- Corregido -->
    <title>@ViewData["Title"]</title>
</head>
<body>
    <h1 class="display-4">Actores</h1>
    <h3>Listado</h3>
    <label >Buscador:</label>
    <input id="Buscador" type="text">

    <div class="Muestra">
            @foreach(var actor in Model)
            {
                <div class="CasillaG">
                    <a  asp-action="Detalle" asp-route-id="@actor.IdActor">
                        <div class="Mimg"><img src="@(actor.IMG)" class="ImgPerfil" alt="Imagen de @actor.Nombre"></div>
                        <label>@actor.Nombre @actor.Apellido</label>
                    <div class="Brillo"></div>
                    </a>
                    <a asp-action="Modificar" asp-route-id="@actor.IdActor">Modificar</a>
                </div>
            }
    </div>

    <script>
        let Buscador= document.getElementById("Buscador")
        
        Buscador.addEventListener("keyup", function filtro()
        {
            listado = document.getElementsByClassName("CasillaG")
            for(f=0;f<listado.length;f++)
            {
                texto=listado[f].textContent
                if(texto.includes(Buscador.value) || (texto.toLowerCase()).includes(Buscador.value))
                {
                    listado[f].dataset.valor="Abierto";
                }
                else
                {
                    listado[f].dataset.valor="Cerrado";;
                }
            }
        })
    </script>
</body>

<style>
    body{
        background-color: rgb(78, 95, 248);
    }
</style>
</html>
