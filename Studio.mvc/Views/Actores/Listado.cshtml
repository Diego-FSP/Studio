@using Actores
@model IEnumerable<ActorVoz>

@{
    ViewData["Title"] = "Actores Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Listas.css"> <!-- Corregido -->
    <title>@ViewData["Title"]</title>
</head>
<body>
    <h1 class="display-4">Actores</h1>
    <h3>Listado</h3>
    <label >Buscador:</label>
    <input id="Buscador" type="text">

    <div class="Muestra">
            @foreach(var actor in Model)
            {
                <div class="ItemActor">
                    <a  asp-action="Detalle" asp-route-id="@actor.IdActor">
                        <img src="@(actor.IMG)" class="ImgPerfil" alt="Imagen de @actor.Nombre">
                    </a>
                    <a  asp-action="Detalle" asp-route-id="@actor.IdActor">
                        @actor.Nombre @actor.Apellido
                    </a>
                    <a asp-action="Modificar" asp-route-id="@actor.IdActor">Modificar</a>
                </div>
            }
    </div>

    <script>
        let Buscador= document.getElementById("Buscador")
        
        Buscador.addEventListener("keyup", function filtro()
        {
            listado = document.getElementsByClassName("ItemActor")
            for(f=0;f<listado.length;f++)
            {
                texto=listado[f].textContent
                if(texto.includes(Buscador.value))
                {
                    listado[f].style.display = 'flex';
                }
                else
                {
                    listado[f].style.display = 'none';
                }
            }
        })
    </script>
</body>
</html>
